(zh
  :header (""
           "MissionD 领域类型 — 枚举 + 核心结构体"
           "Forge: Lisp → DomainTypesDecl → gen_types.rs"
           "")

  (domain-types
    :zh "领域类型"
    :notes ("" "带 as_str() / from_str() 的枚举" "")

    (enum BoardTaskStatus
      :zh "枚举: BoardTaskStatus 看板任务状态"
      :doc-zh "看板任务执行状态"
      (variant Open :zh "变体: Open 开放")
      (variant Running :zh "变体: Running 运行中")
      (variant Verifying :zh "变体: Verifying 验证中")
      (variant Done :zh "变体: Done 已完成")
      (variant Blocked :zh "变体: Blocked 已阻塞")
      (variant Failed :zh "变体: Failed 已失败")
      (variant Skipped :zh "变体: Skipped 已跳过"))

    (enum BoardNoteType
      :zh "枚举: BoardNoteType 看板笔记类型"
      :doc-zh "看板任务笔记类型"
      (variant Progress :zh "变体: Progress 进度")
      (variant Summary :zh "变体: Summary 摘要")
      (variant Note :zh "变体: Note 备注"))

    (enum EngineeringPhase
      :zh "枚举: EngineeringPhase 工程阶段"
      :doc-zh "工程任务流状态机中的阶段"
      (variant Investigate :zh "变体: Investigate 调研")
      (variant ConsultGemini1 :zh "变体: ConsultGemini1 咨询 Gemini 第一次")
      (variant Plan :zh "变体: Plan 规划")
      (variant ConsultGemini2 :zh "变体: ConsultGemini2 咨询 Gemini 第二次")
      (variant Execute :zh "变体: Execute 执行")
      (variant Finalize :zh "变体: Finalize 收尾")
      (variant Done :zh "变体: Done 完成"))

    (enum TaskStatus
      :zh "枚举: TaskStatus 任务状态"
      :doc-zh "后台任务队列状态"
      (variant Queued :zh "变体: Queued 排队中")
      (variant Running :zh "变体: Running 运行中")
      (variant Completed :zh "变体: Completed 已完成")
      (variant Failed :zh "变体: Failed 已失败"))

    (enum EventType
      :zh "枚举: EventType 事件类型"
      :doc-zh "任务事件类型"
      (variant TaskCreated :zh "变体: TaskCreated 任务已创建")
      (variant TaskStarted :zh "变体: TaskStarted 任务已启动")
      (variant TaskCompleted :zh "变体: TaskCompleted 任务已完成")
      (variant TaskFailed :zh "变体: TaskFailed 任务已失败")
      (variant MessageSent :zh "变体: MessageSent 消息已发送")
      (variant MessageReceived :zh "变体: MessageReceived 消息已接收"))

    (enum AsyncJobStatus
      :zh "枚举: AsyncJobStatus 异步作业状态"
      :doc-zh "异步作业执行状态"
      (variant Pending :zh "变体: Pending 待处理")
      (variant Running :zh "变体: Running 运行中")
      (variant Completed :zh "变体: Completed 已完成")
      (variant Failed :zh "变体: Failed 已失败")
      (variant Cancelled :zh "变体: Cancelled 已取消"))

    (enum AgentQuestionStatus
      :zh "枚举: AgentQuestionStatus Agent 问题状态"
      :doc-zh "Agent 问题生命周期状态"
      (variant Pending :zh "变体: Pending 待处理")
      (variant Answered :zh "变体: Answered 已回答")
      (variant Dismissed :zh "变体: Dismissed 已驳回")
      (variant Expired :zh "变体: Expired 已过期")
      (variant Harvested :zh "变体: Harvested 已收割"))

    (enum IncidentSeverity
      :zh "枚举: IncidentSeverity 故障严重级别"
      :doc-zh "故障严重级别"
      (variant Critical :zh "变体: Critical 严重")
      (variant High :zh "变体: High 高")
      (variant Medium :zh "变体: Medium 中")
      (variant Low :zh "变体: Low 低")
      (variant Info :zh "变体: Info 信息"))

    (enum IncidentSource
      :zh "枚举: IncidentSource 故障来源"
      :doc-zh "故障来源系统"
      (variant Monitoring :zh "变体: Monitoring 监控")
      (variant AlertManager :zh "变体: AlertManager 告警管理器")
      (variant Manual :zh "变体: Manual 手动")
      (variant System :zh "变体: System 系统")
      (variant Webhook :zh "变体: Webhook Webhook"))

    (enum DependencyStatus
      :zh "枚举: DependencyStatus 依赖状态"
      :doc-zh "DAG 依赖解析结果")

    (enum CliEngine
      :zh "枚举: CliEngine CLI 引擎"
      :doc-zh "PTY 槽位的 CLI 引擎"
      (variant ClaudeCode :zh "变体: ClaudeCode Claude Code 引擎")
      (variant ClaudeMd :zh "变体: ClaudeMd Claude Md 引擎"))

    (enum Lifecycle
      :zh "枚举: Lifecycle 生命周期"
      :doc-zh "槽位生命周期模式"
      (variant Persistent :zh "变体: Persistent 持久")
      (variant Transient :zh "变体: Transient 临时"))

    (enum SlotTrait
      :zh "枚举: SlotTrait 槽位特性"
      :doc-zh "槽位能力特性"
      (variant Memory :zh "变体: Memory 记忆")
      (variant Sonnet :zh "变体: Sonnet Sonnet 模型")
      (variant AutoPilot :zh "变体: AutoPilot 自动驾驶")
      (variant Decision :zh "变体: Decision 决策")
      (variant Strategy :zh "变体: Strategy 策略"))

    :notes ("" "核心结构体" "")

    (struct FlowContext
      :zh "结构体: FlowContext 流程上下文"
      :doc-zh "工程流程各阶段之间传递的上下文"
      (field investigation_report :zh "字段: investigation_report 调研报告")
      (field gemini_advice_1 :zh "字段: gemini_advice_1 第一次 Gemini 建议")
      (field execution_plan :zh "字段: execution_plan 执行计划")
      (field gemini_advice_2 :zh "字段: gemini_advice_2 第二次 Gemini 建议")
      (field execution_result :zh "字段: execution_result 执行结果")
      (field commit_hash :zh "字段: commit_hash 提交哈希"))

    (struct BoardTask
      :zh "结构体: BoardTask 看板任务"
      :doc-zh "个人任务看板条目"
      (field id :zh "字段: id 任务 ID")
