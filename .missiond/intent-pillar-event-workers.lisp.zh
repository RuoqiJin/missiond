(zh
  :header ("MissionD — 支柱: event-workers（事件工作器）"
           "从 intent.lisp 拆分，支持并行加载"
           "父文件: intent.lisp")

  (pillar event-workers
    :zh "支柱: 事件-工作器（pub-sub 骨干 + 21 个后台 worker）"

    (purpose :zh "用途: 发布-订阅事件骨干 + 21 个后台 worker，按 LLM 依赖划分: sonnet(6) codex(2) gemini(1) local(12)")

    :notes ("local 计数变迁: +codex_ingestion_worker (ec269d7); EventAnalyzerWorker(65c8b59) 并入 tagger-chunker(1ea1838); +xjpcode_briefing_worker (8e5efaf)"
            "workers/sonnet/ — 通过 SonnetGateway 访问 Sonnet API"
            "workers/codex/ — Codex CLI / Claude Code PTY，通过 SlotManager 调度"
            "workers/gemini/ — Gemini CLI PTY，通过 SlotManager 调度"
            "workers/local/ — 纯本地计算，不依赖 LLM"
            "数量: 12 个 worker（原 11; +xjpcode_briefing_worker 8e5efaf; 此前 +codex_ingestion_worker ec269d7; EventAnalyzerWorker 并入 tagger-chunker 1ea1838）")

    (component event-bus
      :zh "组件: 事件总线"

      (description :zh "描述: tokio broadcast 通道 hub，承载 DaemonEvent 枚举")

      (event-categories
        :zh "事件分类"
        (pty-events       :zh "pty 事件: 状态变更、输出、截屏")
        (message-events   :zh "消息事件: JSONL 消息入库、消息持久化")
        (task-events      :zh "任务事件: 提交、完成、失败")
        (board-events     :zh "看板事件: 任务创建、更新、认领")
        (slot-events      :zh "槽位事件: 空闲、卡住、会话切换")
        (knowledge-events :zh "知识事件: KB 条目创建、更新")
        (system-events    :zh "系统事件: worker 状态变更、关机请求")
        (cascade-events   :zh "级联事件: 触发、完成")
        (commit-events    :zh "commit 事件: 带上下文的 commit 检测（会话 ID / 槽位 ID / commit 哈希 / 消息）")

        :notes ("commit 65c8b59: ContextualCommitDetected 替换旧的 CommitDetected 事件"
                "携带 conversation_id/session_id/slot_id — 桥接\"哪个 commit\" 与\"哪个会话产生的\"")))

    (component event-router
      :zh "组件: 事件路由器"

      (note :zh "注: 仅作信号发射器 — 所有事件驱动处理改用 BackgroundWorker trait")

      :notes ("commit c8b76b0: 降级为 Notify 信号发射器 — 不再派生孤儿协程"
              "strategy / retro / ast-sync 迁移到 BackgroundWorker trait; event_router 只剩薄广播层"))

    (component events-sync
      :zh "组件: 事件同步器"

      (writes-to :zh "写入: system_timeline"))

    (component worker-registry
      :zh "组件: worker 注册表"

      (trait BackgroundWorker
        :zh "trait: BackgroundWorker"
        (const KIND :zh "KIND 常量: 枚举 Sonnet / Codex / Gemini / Local")
        (methods :zh "方法: name / extra-deps / run"))

      (note :zh "注: KIND 必须匹配 worker 所在子目录; ControlTree provider 依赖由 spawn_worker 自动注入")

      :notes ("commit c8b76b0: strategy-worker (Gemini)、retro-worker (Sonnet)、ast-sync-worker (Local)"
              "从零散 async fn 改造为 BackgroundWorker 实现，支持 ControlTree 暂停 / 恢复"
              "关闭 ControlTree 执行力漏洞 — 所有事件驱动 worker 现在都遵守级联暂停 / 恢复"))

    (component control-tree
      :zh "组件: 控制树"

      (struct ControlTree
        :zh "结构体: ControlTree"
        (field global_paused :zh "全局暂停标志")
        (field providers     :zh "按 Provider 暂停状态")
        (field domains       :zh "按 Domain 暂停状态")
        (field workers       :zh "按 worker 名暂停状态"
          :note-zh "注: true=强制暂停; false=强制恢复（调试覆盖）; 不存在=跟随级联")
        (field slot_roles    :zh "按槽位角色暂停状态")
        (field projects      :zh "按项目 ID 暂停状态"
          :note-zh "注: project_id → 是否暂停; P2+P3 新增（commit 50a5296）。is_project_paused() 查表默认 false")
        (field domain_paused_at :zh "域暂停时间戳; 仅信息性，不影响判断"))

      (cascade-priority
        :zh "级联优先级"
        :note-zh "注: is_effectively_paused() 求值顺序"
        (1 worker-explicit-override
          :zh "1. worker 显式覆盖"
          :semantics-zh "语义: workers[名]=true → 恒暂停; workers[名]=false → 恒恢复（调试模式）")
        (2 global-kill-switch
          :zh "2. 全局总闸"
          :semantics-zh "语义: global_paused=true → 所有 worker 暂停（除非有显式覆盖）")
        (3 provider-domain-cascade
          :zh "3. provider-domain 级联"
          :semantics-zh "语义: 逐个检查 Dependency::Provider / Dependency::Domain; 任一 true → 暂停"))

      (method is_worker_paused
        :zh "方法: is_worker_paused"
        :semantics-zh "语义: worker 显式覆盖优先于 global; 不存在 → 跟随 global_paused")

      (method is_effectively_paused
        :zh "方法: is_effectively_paused"
        :semantics-zh "语义: 完整级联: worker 覆盖 > global > provider / domain 依赖")

      (method status_summary
        :zh "方法: status_summary"
        :fields-zh "字段: 全局暂停 / providers / domains / 已暂停 workers / 强制恢复 workers / 槽位角色"
        :note-zh "注: workers 拆成 paused / force_resumed 两个列表，便于调试观察")

      (struct ControlManager
        :zh "结构体: ControlManager"
        :pattern-zh "模式: 基于 watch 的推送广播（非轮询）"
        :semantics-zh "语义: 变更 → send_modify() 原子更新 → 所有订阅者通过 changed().await 收到通知"
        :persistence-zh "持久化: control_tree.json — 崩溃恢复通过 spawn_blocking 写入"
        :note-zh "注: Worker 在 select! 中 await watch::Receiver::changed() — 零成本异步推送，非 HashMap 轮询"
        (mutations :zh "变更方法集: set_global_paused / set_provider / set_domain / set_worker / set_slot_role / set_project")

        :notes ("set_project: paused=true → 插入 project_id; paused=false → 移除（不存 false 条目）"))

      :notes ("项目暂停: is_project_paused(id) 由 handler 独立检查,"
              "不属于 is_effectively_paused() worker 级联 — 项目控制数据流，不控制 worker"))

    (component workers-sonnet
      :zh "组件: Sonnet 类 worker 集合"

      (worker embedding-worker
        :zh "worker: 嵌入生成"
        :trigger-zh "触发: MPSC 通道 embedding_rx"
        :writes-to-zh "写入: knowledge / conversation_topic_vectors")

      (worker translation-worker
        :zh "worker: 翻译"
        :trigger-zh "触发: 5 秒轮询"
        :writes-to-zh "写入: translations")

      (worker briefing-worker
        :zh "worker: 简报生成"
        :trigger-zh "触发: 按需")

      (worker arch-maintenance-worker
        :zh "worker: 架构维护"
        :trigger-zh "触发: ContextualCommitDetected 事件（commit 65c8b59 前为 3600 秒轮询）"
        :writes-to-zh "写入: knowledge"
        :note-zh "注: commit 65c8b59 后消费 ContextualCommitDetected（带会话上下文的富事件），不再轮询 git-log")

      (worker retro-worker
        :zh "worker: 复盘"
        :trigger-zh "触发: 会话结束时"
        :writes-to-zh "写入: retrospective_results"
        :note-zh "注: commit c8b76b0 后改造为 BackgroundWorker 实现，遵守 ControlTree 暂停 / 恢复")

      (worker lisp-survey-worker
        :zh "worker: lisp 测绘"
        :trigger-zh "触发: ContextualCommitDetected 事件"
        :routes-to-zh "路由到: lisp-surveyor（常驻 Sonnet 槽位，超时 900 秒）"
        :writes-to-zh "写入: 项目 intent.lisp（通过槽位 Edit 工具）"
        :debounce-zh "去抖: 每个 project_id 60 秒"
        :filters-zh "过滤: 自触发屏蔽 — slot_id == lisp-surveyor 的 commit 跳过"
        :diff-truncation-zh "diff 截断: 最多 8000 字符"
        :flow-zh ("流程:"
                  "→ 自触发过滤（slot_id == lisp-surveyor → 跳过）"
                  "→ ProjectRegistry::resolve(project_id) → 查 intent_path"
                  "→ 未配置 intent.lisp 则跳过"
                  "→ 60 秒去抖（HashMap<String, Instant>）"
                  "→ 构造增量测绘 prompt（diff + intent.lisp 路径）"
                  "→ 解析响应: NO_CHANGE → 跳过; 否则由槽位更新 intent.lisp")

        :notes ("commit 79a877f: 新增")))

    (component workers-codex
      :zh "组件: codex 类 worker 集合"

      (worker step-narrator
        :zh "worker: 步骤叙述"
        :listens-to-zh "监听: MessagePersisted 事件"
        :writes-to-zh "写入: message_narrations / narration_cursors")

      (worker vision-worker
        :zh "worker: 视觉分析"
        :trigger-zh "触发: 通道"
        :writes-to-zh "写入: image_descriptions"))

    (component workers-gemini
      :zh "组件: gemini 类 worker 集合"

      (worker strategy-worker
        :zh "worker: 策略生成"
        :trigger-zh "触发: 300 秒轮询（flag 门控）"
        :note-zh "注: commit c8b76b0 后改造为 BackgroundWorker 实现，遵守 ControlTree 暂停 / 恢复"))

    (component workers-local
      :zh "组件: 本地 worker 集合"

      (worker conversation-logger
        :zh "worker: 会话记录"
        :listens-to-zh "监听: JsonlMessageIngested 事件"
        :writes-to-zh "写入: conversations / conversation_messages")

      (worker conversation-organizer
        :zh "worker: 会话整理"
        :listens-to-zh "监听: ConversationMessageLogged 事件"
        :emits-zh "发射: SessionOrganized 事件"

        :notes ("commit ad889d1: 去除 agent-only 过滤 — 原仅处理 agent-* session，用户前台 session 被忽略"
                "修复后：所有 session_id 均进 dirty 集合，统一在 5s debounce 后 emit SessionOrganized"
                "P0 compaction link 和 P1 orphan parent fix 仍仅对 agent-* 执行，非 agent session 跳过"
                "commit 43c80f4: broadcast lagged warning 语义明确为 \"events permanently lost\""
                "  (TaggerChunker 的 reconcile sweep 可在 60s 内补处理这些丢失的 session)"))

      (worker pty-event-worker
        :zh "worker: PTY 事件"
        :listens-to-zh "监听: PtyStateChanged 事件"
        :emits-zh "发射: SlotBecameIdle / SlotStuck"

        :notes ("commit ec269d7: 自动批准包含 \"don't ask again\" / \"always\" / \"trust\" / \"不再\" 的确认对话框"
                "发送 ConfirmResponse::Option(2): 两次连续 PTY 写入（数字 + 回车，间隔 80ms）"
                "unicode 弯引号（U+2019）归一化，便于 ' 与 ASCII ' 一致匹配"))

      (worker tagger-chunker
        :zh "worker: 打标分块"
        :listens-to-zh "监听: SessionOrganized 事件"

        :notes ("commit 21a3b63: TurnBuilder 从 tool 调用抽取 files_read / files_changed / outcome"
                "build_turn_embedding_text: 关键字密集格式（project:X files:Y intent:Z outcome:W）"
                "过滤 <task-notification> 噪音 turn; 回填后触发逐 turn 嵌入生成（dc45dcb）"
                "commit 1ea1838: commit 检测逻辑从 EventAnalyzerWorker 迁移到这里"
                "commit 081b4f9: 从 [Tool: Bash] 内容格式解析真实命令"
                ""
                ""
                ""
                ""
                ""
                ""
                ""
                "  - broadcast lagged → warn! \"events permanently lost\"（事件永久丢失）"
                ""))

      (worker experience-harvester
        :zh "worker: 经验采集"
        :trigger-zh "触发: 60 秒轮询"
        :writes-to-zh "写入: knowledge")

      (worker reconcile-worker
        :zh "worker: 对账"
        :trigger-zh "触发: 10 秒轮询"
        :writes-to-zh "写入: slot_sessions"
        :note-zh "")

      (worker gemini-reconcile-worker
        :zh "worker: gemini 对账"
        :trigger-zh "触发: 10 秒轮询"
        :note-zh "")

      (worker ast-sync-worker
        :zh "worker: AST 同步"
        :trigger-zh "触发: MPSC 通道 ast_sync_rx"
        :writes-to-zh "写入: ast_nodes"
        :note-zh "注: commit c8b76b0 后改造为 BackgroundWorker 实现，遵守 ControlTree 暂停 / 恢复")

      (worker code-prefetch
        :zh "worker: 代码预取"
        :trigger-zh "触发: 按需")

      (worker codex-ingestion-worker
        :zh "worker: codex 历史摄入"
        :trigger-zh "触发: 通过 rusqlite 轮询 ~/.codex/state_5.sqlite"
        :writes-to-zh "写入: 会话时间线（system_timeline）+ conversation_messages（文本消息）"
        :note-zh "注: 从本地 SQLite 读取 Codex CLI 操作历史，摄入 MissionD 会话时间线。rusqlite 已加入 missiond-daemon Cargo.toml，在 main.rs 随 daemon 启动。"

        :notes (""
                ""
                "  - 轮询间隔 30s → 10s（POLL_INTERVAL_SECS=10）"))

      (worker gemini-logger
        :zh "worker: gemini 日志记录"
        :trigger-zh "触发: 通道"
        :writes-to-zh "写入: gemini_requests")

      (worker xjpcode-briefing-worker
        :zh "worker: xjpcode 简报"
        :trigger-zh "触发: 60 秒轮询（初始延迟 15 秒，MissedTickBehavior::Skip）"
        :writes-to-zh "写入: ~/.xjpcode/xjpcode.md（文件系统，原子 std::fs::write）"
        :sources-zh "数据源: list_board_tasks (running + failed) + list_incidents(5) + list_projects()"
        :pauses-zh "暂停: ControlTree ctx.wait_if_paused()"
        :doc-zh "文档: 为 xjpcode CLI 生成系统简报 markdown; xjpcode 启动时读取 → 注入 system prompt 上下文。xjpcode ↔ missiond 神经链路的一部分。"

        :notes ("commit 8e5efaf: 新增 — xjpcode 神经链路简报"))

      :notes ("EventAnalyzerWorker (65c8b59) 新增后被并入 tagger-chunker (1ea1838)"
              "commit 检测现在在 tagger_chunker 的 schema-on-write 阶段完成，可获得完整消息内容"))))
