  ;; ── 设计约束 ──

    ;; 子块：Crate 边界划分 — 每个 Rust 包管什么
      ;; 公共枚举 CliEngine + 默认 mission 主目录 — 从 semantic-terminal 重新导出
      ;; ⚠ missiond-semantic 已删除（提交 5a5f805）— 现在是外部 crate：
      ;;   Cargo workspace 依赖: semantic-terminal = { path = "../semantic-terminal/..." }
      ;;   （github.com/ruoqijin/semantic-terminal，独立开源仓库）
      ;;   pure_parsing/（Forge 生成的）已搬到 missiond-core/src/semantic_parsing/
      ;; [外部] 语义终端解析器：指纹、状态、确认、标题、工具、状态、模式
      ;; PTY 会话管理：管理器、会话、增量提取器、截屏
      ;; 类型、DB trait、IPC、embedding、上下文 — 依赖 pty + semantic-terminal(外部) + shared
      ;; 业务逻辑、处理器、引擎、worker(sonnet/codex/gemini/local)、LLM 网关
      ;; MCP JSON-RPC stdio 服务器，工具 schema + 请求分发
      ;; CLI 终端附着工具
      ;; Claude CLI 进程包装器
      ;; 给 Node.js 调用语义解析器的 N-API 绑定
      ;; 独立的 Skill 商店微服务

    ;; 子块：通信方式
      ;; 进程内：DaemonEvent 广播 + 每个 worker 一条 MPSC 管道
      ;; 进程间：mcp↔daemon 走 Unix 套接字或 TCP
      ;; 浏览器：WebSocket(tokio-tungstenite) 推送实时看板

    ;; 子块：数据库访问规则
      ;; 后端：PostgreSQL via sqlx::PgPool — 默认且唯一的生产后端（Cargo 默认 features=[postgres]）
      ;; 抽象层：Arc<dyn MissionStore> — 聚合 13 个领域 store 的超 trait（db/traits.rs:750）
      ;; 13 个领域 trait：Conversation 消息 工具调用 事件 复盘 视觉 知识 看板 时间线 槽位 技能 可观测性 项目
      ;; 实现
        ;; PG 实现：PgMissionStore(db/pg/mod.rs) — 原生 async sqlx，15 文件，约 1.2 万行
        ;; SQLite 实现：SqliteMissionStore(db/sqlite/mod.rs) — 遗留代码，--features sqlite 开启；包装同步 MissionDB 经 DbExecutor/spawn_blocking；**仅为支持 pg::migrate_from_sqlite 迁移工具保留**
      ;; 网关：missiond-core/src/db/ 是唯一数据库入口 — 消费方注入 Arc<dyn MissionStore>
      ;; 迁移：crates/missiond-core/migrations/ 下 16 个 SQL 文件，daemon 启动时由 sqlx::migrate! 执行
      ;; 孤儿产物
        ;; ⚠ DB 层的 Forge 代码生成管线**没接入构建**：
        ;;   - .missiond/intent-db*.lisp（8 个文件，都是 :backend sqlite）— 没被此文件 module-link
        ;;   - db/gen/*.rs（8 个已提交文件）— db/mod.rs 没 mod gen 声明，永不编译
        ;;   - db/gen_*.rs（根目录 8 个 untracked 文件）— 老 Forge 配置的僵尸输出
        ;; 所有手写 DB 代码都在 db/pg/ 和 db/sqlite/ 里；Forge 管线要么重接要么删除
        ;; "intent-db*.lisp 和 db/gen*/*.rs 存在但未使用"

    ;; 子块：权威源 — 每个领域谁说了算
      ;; 终端状态 → 语义解析器管线说了算
      ;; 任务生命周期 → autopilot 定时循环说了算
      ;; 槽位生命周期 → SlotManager 说了算
      ;; 知识库内容 → PG 数据库表说了算
      ;; 权限判断 → PermissionPolicy + LearnedPermissions 说了算

  ;; ── 上游依赖（改它们会炸我） ──
