#!/usr/bin/env bash
# MissionD task-contract aware pre-commit hook.
#
# Activation rule:
#   Runs scripts/check-staged-source-hygiene.mjs ONLY when the
#   environment variable MISSIOND_TASK_CONTRACT is set to a task.lisp path.
#   Without that variable the hook is a no-op (exit 0) so it stays opt-in
#   per commit / per agent session.
#
# To enable this hook for the local clone (repo-local only — never global):
#   node scripts/install-missiond-hooks.mjs --install
# Or, equivalently:
#   git config core.hooksPath .githooks
#
# To inspect the current state without mutating anything:
#   node scripts/check-missiond-hooks.mjs            # human output
#   node scripts/check-missiond-hooks.mjs --json     # machine-readable
#
# To run the guard for a single commit:
#   MISSIOND_TASK_CONTRACT=.missiond/tasks/wave21/wave21-01-hooks-path-installer-v1.lisp \
#     git commit -m "feat(tasks): ..."
#
# The hygiene checker itself is read-only: no git add / commit / reset /
# checkout / stash / push / merge / rebase. It checks staged NUL bytes,
# git diff --cached --check whitespace errors, then delegates staged scope
# enforcement to scripts/task-scope-guard.mjs. This wrapper only forwards
# exit codes; it never mutates the index, working tree, or remotes.

set -euo pipefail

if [ -z "${MISSIOND_TASK_CONTRACT:-}" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
hygiene="${repo_root}/scripts/check-staged-source-hygiene.mjs"
contract="${MISSIOND_TASK_CONTRACT}"

if [ ! -f "${hygiene}" ]; then
  echo "pre-commit: check-staged-source-hygiene.mjs not found at ${hygiene}" >&2
  exit 1
fi

# Resolve the contract path relative to the repo root if it is not absolute
# and not already resolvable from the current working directory.
case "${contract}" in
  /*) ;;
  *)
    if [ ! -f "${contract}" ] && [ -f "${repo_root}/${contract}" ]; then
      contract="${repo_root}/${contract}"
    fi
    ;;
esac

if [ ! -f "${contract}" ]; then
  echo "pre-commit: task contract file not found: ${MISSIOND_TASK_CONTRACT}" >&2
  exit 1
fi

exec node "${hygiene}" --task "${contract}"
